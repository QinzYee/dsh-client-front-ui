{
  "name": "dsh-client-front-ui",
  "version": "0.3.2",
  "type": "module",
  "description": "Three interface modules for the DSH Web GUI — fonts, workspace sidebar and plugin rail — with independent switches and collapsible panels.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinzYee/dsh-client-front-ui.git"
  },
  "homepage": "https://github.com/QinzYee/dsh-client-front-ui#readme",
  "bugs": {
    "url": "https://github.com/QinzYee/dsh-client-front-ui/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "font",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
